{
  "name": "kenrick-sites",
  "packageManager": "yarn@4.3.1",
  "devDependencies": {
    "esbuild": "^0.25.5",
    "prettier": "^3.5.3"
  },
  "scripts": {
    "setup": "printf 'Setup HTTPS certs (one-time):\\n  brew install mkcert\\n  mkcert -install\\n  mkdir -p $HOME/.local/share/mkcert\\n  mkcert -cert-file $HOME/.local/share/mkcert/localhost.pem -key-file $HOME/.local/share/mkcert/localhost-key.pem localhost\\n'",
    "dev": "python3 -m http.server 8443 --tls-cert $HOME/.local/share/mkcert/localhost.pem --tls-key $HOME/.local/share/mkcert/localhost-key.pem",
    "build:graphing": "esbuild graphing.ts --bundle --outfile=dist/graphing.js",
    "watch:graphing": "esbuild graphing.ts --bundle --outfile=dist/graphing.js --watch",
    "build:transpose": "esbuild transpose.ts --bundle --outfile=dist/transpose.js",
    "watch:transpose": "esbuild transpose.ts --bundle --outfile=dist/transpose.js --watch",
    "build:loop": "cp node_modules/rubberband-web/public/rubberband-processor.js rubberband-processor.txt && esbuild loop.ts --bundle --outfile=dist/loop.js --loader:.txt=text --platform=browser --external:path --external:fs --external:crypto",
    "watch:loop": "cp node_modules/rubberband-web/public/rubberband-processor.js rubberband-processor.txt && esbuild loop.ts --bundle --outfile=dist/loop.js --loader:.txt=text --platform=browser --external:path --external:fs --external:crypto --watch",
    "build:tuner": "esbuild tuner.ts --bundle --outfile=dist/tuner.js",
    "watch:tuner": "esbuild tuner.ts --bundle --outfile=dist/tuner.js --watch"
  },
  "dependencies": {
    "decimal.js": "^10.5.0",
    "essentia.js": "^0.1.3",
    "pitchy": "^4.1.0",
    "rubberband-web": "^0.2.1"
  }
}
